{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backforagammon",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "routes": [
    {
      "pattern": "backforagammon.com",
      "custom_domain": true
    },
    {
      "pattern": "www.backforagammon.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
